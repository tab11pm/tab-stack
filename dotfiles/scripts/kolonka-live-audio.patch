+def live(out):
+    """Пишет в out MP3 того, что сейчас играет на ПК. Остаётся задержка на буфер mpd (секунды)."""
+    sink = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True).stdout.strip()
+    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-fflags", "nobuffer",
+           "-f", "pulse", "-i", f"{sink}.monitor", "-ac", str(CH), "-ar", str(RATE),
+           "-c:a", "libmp3lame", "-b:a", "192k", "-flush_packets", "1", "-f", "mp3", "-"]
+    p = subprocess.Popen(cmd, stdout=subprocess.PIPE)
+    try:
+        while chunk := p.stdout.read1(16 << 10):
+            out.write(chunk)
+            out.flush()
+    except (BrokenPipeError, ConnectionResetError):
+        pass
+    finally:
+        p.kill()
+        p.wait()
+
